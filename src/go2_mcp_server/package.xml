<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_mcp_server</name>
  <version>0.1.0</version>
  <description>MCP server exposing Go2 Nav2 navigation (list_places, navigate_to_place, get_navigation_status, cancel_navigation) as tools an LLM can call.</description>
  <maintainer email="mohammad.mk012@gmail.com">kan</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>go2_semantic_map</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
