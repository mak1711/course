<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="stairs">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>3.5 2 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 6 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 6 0.1</size></box></geometry>
          <material><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Ten 1 m-wide steps ascending in +X. Every rise is 0.12 m.
      Steps 1-2 and 4-9 have a 0.12 m run; steps 3 and 10 are
      1 m-long landings (the third step and the seventh step after it).
    -->
    <model name="stairs">
      <static>true</static>
      <pose>2.5 2 0 0 0 0</pose>
      <link name="link">
        <collision name="step_1_collision"><pose>0.06 0 0.06 0 0 0</pose><geometry><box><size>0.12 1 0.12</size></box></geometry></collision>
        <visual name="step_1_visual"><pose>0.06 0 0.06 0 0 0</pose><geometry><box><size>0.12 1 0.12</size></box></geometry><material><diffuse>0.55 0.32 0.14 1</diffuse></material></visual>

        <collision name="step_2_collision"><pose>0.18 0 0.12 0 0 0</pose><geometry><box><size>0.12 1 0.24</size></box></geometry></collision>
        <visual name="step_2_visual"><pose>0.18 0 0.12 0 0 0</pose><geometry><box><size>0.12 1 0.24</size></box></geometry><material><diffuse>0.58 0.35 0.16 1</diffuse></material></visual>

        <collision name="step_3_landing_collision"><pose>0.74 0 0.18 0 0 0</pose><geometry><box><size>1 1 0.36</size></box></geometry></collision>
        <visual name="step_3_landing_visual"><pose>0.74 0 0.18 0 0 0</pose><geometry><box><size>1 1 0.36</size></box></geometry><material><diffuse>0.61 0.38 0.18 1</diffuse></material></visual>

        <collision name="step_4_collision"><pose>1.30 0 0.24 0 0 0</pose><geometry><box><size>0.12 1 0.48</size></box></geometry></collision>
        <visual name="step_4_visual"><pose>1.30 0 0.24 0 0 0</pose><geometry><box><size>0.12 1 0.48</size></box></geometry><material><diffuse>0.64 0.41 0.20 1</diffuse></material></visual>

        <collision name="step_5_collision"><pose>1.42 0 0.30 0 0 0</pose><geometry><box><size>0.12 1 0.60</size></box></geometry></collision>
        <visual name="step_5_visual"><pose>1.42 0 0.30 0 0 0</pose><geometry><box><size>0.12 1 0.60</size></box></geometry><material><diffuse>0.67 0.44 0.22 1</diffuse></material></visual>

        <collision name="step_6_collision"><pose>1.54 0 0.36 0 0 0</pose><geometry><box><size>0.12 1 0.72</size></box></geometry></collision>
        <visual name="step_6_visual"><pose>1.54 0 0.36 0 0 0</pose><geometry><box><size>0.12 1 0.72</size></box></geometry><material><diffuse>0.70 0.47 0.24 1</diffuse></material></visual>

        <collision name="step_7_collision"><pose>1.66 0 0.42 0 0 0</pose><geometry><box><size>0.12 1 0.84</size></box></geometry></collision>
        <visual name="step_7_visual"><pose>1.66 0 0.42 0 0 0</pose><geometry><box><size>0.12 1 0.84</size></box></geometry><material><diffuse>0.73 0.50 0.26 1</diffuse></material></visual>

        <collision name="step_8_collision"><pose>1.78 0 0.48 0 0 0</pose><geometry><box><size>0.12 1 0.96</size></box></geometry></collision>
        <visual name="step_8_visual"><pose>1.78 0 0.48 0 0 0</pose><geometry><box><size>0.12 1 0.96</size></box></geometry><material><diffuse>0.76 0.53 0.28 1</diffuse></material></visual>

        <collision name="step_9_collision"><pose>1.90 0 0.54 0 0 0</pose><geometry><box><size>0.12 1 1.08</size></box></geometry></collision>
        <visual name="step_9_visual"><pose>1.90 0 0.54 0 0 0</pose><geometry><box><size>0.12 1 1.08</size></box></geometry><material><diffuse>0.79 0.56 0.30 1</diffuse></material></visual>

        <collision name="step_10_landing_collision"><pose>2.46 0 0.60 0 0 0</pose><geometry><box><size>1 1 1.20</size></box></geometry></collision>
        <visual name="step_10_landing_visual"><pose>2.46 0 0.60 0 0 0</pose><geometry><box><size>1 1 1.20</size></box></geometry><material><diffuse>0.82 0.59 0.32 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
